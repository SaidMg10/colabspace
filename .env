ENV=development

# Configuración del servidor
SERVER_HOST=0.0.0.0         # Host donde corre el servidor
SERVER_PORT=8080            # Puerto donde escucha el servidor
SERVER_READ_TIMEOUT=5s      # Tiempo máximo para leer la request
SERVER_WRITE_TIMEOUT=10s    # Tiempo máximo para escribir la response
SERVER_IDLE_TIMEOUT=120s    # Tiempo máximo para mantener conexiones inactivas
SERVER_SHUTDOWN_TIMEOUT=10s # Tiempo para apagado ordenado

# Configuración general de la app
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
ENV=development

# Configuración general de la base de datos

DB_DSN=postgres://admin:adminpassword@localhost:5432/colabspace?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_MAX_IDLE_TIME=15m

# Configuración de autenticación (JWT y Basic)

AUTH_BASIC_USER=tuUsuarioBasico
AUTH_BASIC_PASS=tuPasswordBasico

AUTH_TOKEN_SECRET=unaClaveSecretaMuyFuerteYRandom # << clave secreta para firmar JWT
AUTH_TOKEN_EXP=24h                                # << duración del token, ej. 24h
AUTH_TOKEN_ISS=myapp                              # << issuer, nombre de tu app o dominio
